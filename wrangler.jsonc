/**
 * One Worker serves everything: the built client through the Assets binding,
 * plus /api/* and /ws. One `wrangler deploy`, one origin, no CORS.
 *
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uno",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-05",

	/**
	 * No `nodejs_compat` flag: the Worker, the Durable Object and the shared
	 * rules engine use Web-standard APIs only — crypto.getRandomValues,
	 * structuredClone, WebSocketPair, URL.
	 */

	"assets": {
		// `directory` is filled in by the Vite plugin when it writes the
		// deployment config during `vite build`.
		"not_found_handling": "single-page-application"
	},

	/** One Durable Object instance per room — the DO *is* the game. */
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "Room"
			}
		]
	},

	/** SQLite-backed classes are the ones available on the free plan. */
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Room"]
		}
	],

	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
